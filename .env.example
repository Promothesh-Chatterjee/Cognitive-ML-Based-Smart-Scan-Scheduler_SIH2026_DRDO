# HuggingFace Token for downloading TSRD dataset (https://huggingface.co/settings/tokens)
HF_TOKEN=your_huggingface_token_here
# Compute device: cuda or cpu (auto-fallback on OOM)
DEVICE=cuda
# WandB project for logging
WANDB_PROJECT=your_project_name
# API host/port
API_HOST=0.0.0.0
API_PORT=8000

# OpenTelemetry Tracing (Optional)
OTEL_EXPORTER_OTLP_ENDPOINT=

# Hardware Abstraction Layer backend (simulated | zmq)
RECEIVER_BACKEND=simulated
ZMQ_RECEIVER_ADDR=tcp://localhost:5555

# TSRD Dataset & Google Cloud Storage Configuration
TSRD_DATA_ROOT=D:/TSRD
GCS_TSRD_BUCKET=sih2026-ew-tsrd
GCP_PROJECT=sih2026-ew-demo
GCP_REGION=asia-south1

# Live Google Cloud Run Deployment
CLOUD_RUN_URL=https://cognitive-ew-backend-753709137146.asia-south1.run.app

# Set for authenticated deployment access (X-SmartScan-API-Key / X-API-Key header)
SMARTSCAN_API_KEY=your_smartscan_api_key_here

# Frontend Vite / Vercel Configuration
VITE_API_BASE_URL=https://cognitive-ew-backend-753709137146.asia-south1.run.app
VITE_WS_BASE_URL=wss://cognitive-ew-backend-753709137146.asia-south1.run.app
VITE_SMARTSCAN_API_KEY=your_smartscan_api_key_here
